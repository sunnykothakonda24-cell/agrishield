# Server
PORT=5000
NODE_ENV=development
# Firebase Admin: keep the service-account private key in backend/.env only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# Frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI providers
AI_PROVIDER=ollama
OPENAI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_NUM_THREADS=8
OLLAMA_KEEP_ALIVE=-1
OLLAMA_PREWARM=true

AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=1024

# Speech-to-text
AI_STT_PROVIDER=whisper-local
WHISPER_MODEL=onnx-community/whisper-tiny
WHISPER_CACHE_DIR=
FFMPEG_PATH=
AI_STT_MODEL=

# Text-to-speech
AI_TTS_PROVIDER=google-cloud
AI_TTS_MODEL=
GOOGLE_CLOUD_TTS_API_KEY=

# Location search
NOMINATIM_CONTACT_EMAIL=

# Support contacts
SUPPORT_PHONE=
SUPPORT_EMAIL=
