# Server
PORT=5000
NODE_ENV=development
# Set TRUST_PROXY=1 only when exactly one trusted HTTPS reverse proxy fronts this server.
TRUST_PROXY=
# Project A: private identity/profile and ownership metadata. Keep keys in backend/.env only.
# Preserve the existing Firebase identity project and UID pool.
# Legacy FIREBASE_* values are accepted for Project A during this transition.
PRIVATE_FIREBASE_PROJECT_ID=agrisheild-22749
PRIVATE_FIREBASE_CLIENT_EMAIL=
PRIVATE_FIREBASE_PRIVATE_KEY=
PRIVATE_FIREBASE_CREDENTIALS_FILE=
PRIVATE_FIREBASE_AUTH_EMULATOR_HOST=
PRIVATE_FIRESTORE_EMULATOR_HOST=


# Project B: application data (Admin credentials must belong to Project B).
APP_FIREBASE_PROJECT_ID=agrishield-61486
APP_FIREBASE_CLIENT_EMAIL=
APP_FIREBASE_PRIVATE_KEY=
APP_FIREBASE_CREDENTIALS_FILE=
APP_FIRESTORE_EMULATOR_HOST=

# Legacy Project A configuration. Remove after local deployment configuration has migrated.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# Local development example. Production must replace these with exact public HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini is primary. Ollama is available only when explicitly selected with AI_PROVIDER=ollama.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_ENABLED=true
GEMINI_LIVE_MAX_MINUTES=30
# Private Cloudinary storage for authenticated AI crop-image attachments
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AI_FOLDER=agrishield/ai-images
OPENAI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_NUM_THREADS=8
OLLAMA_KEEP_ALIVE=-1
OLLAMA_PREWARM=true

AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=1024

# ElevenLabs speech services (credentials and voice IDs stay on the backend)
ELEVENLABS_API_KEY=""
ELEVENLABS_STT_MODEL="scribe_v2"
ELEVENLABS_TTS_MODEL="eleven_v3"
ELEVENLABS_TTS_EN_VOICE_ID=""
ELEVENLABS_TTS_HI_VOICE_ID=""
ELEVENLABS_TTS_TE_VOICE_ID=""
STT_ENABLED=true
VOICE_MAX_RECORDING_SECONDS=60
TTS_ENABLED=true

# Location search
NOMINATIM_CONTACT_EMAIL=

# Support contacts
SUPPORT_PHONE=
SUPPORT_EMAIL=
